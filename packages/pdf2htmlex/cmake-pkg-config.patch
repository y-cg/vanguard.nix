+pkg_check_modules(GLIB REQUIRED glib-2.0 gio-2.0 gobject-2.0)
+pkg_check_modules(LIBXML REQUIRED libxml-2.0)
+pkg_check_modules(FREETYPE REQUIRED freetype2)
+include_directories(
+  ${GLIB_INCLUDE_DIRS}
+  ${LIBXML_INCLUDE_DIRS}
+  ${FREETYPE_INCLUDE_DIRS}
+)
+
 
